# Claude — local settings stay out; the checked-in skills are shared tooling.
# Must be `.claude/*` not `.claude/`: git never descends into an ignored directory,
# so a trailing-slash pattern would make the negation below unreachable.
.claude/*
!.claude/skills/

# macOS
.DS_Store
**/.DS_Store

# Node
node_modules/
dist/
.vite/
# TypeScript's incremental state, written by a local `tsc` run.
*.tsbuildinfo

# Coverage reports, written by `make coverage-frontend` and `make coverage-backend`.
frontend/coverage/
backend/htmlcov/
backend/.coverage
backend/coverage.json

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Env
.env
.env.local

# Keys
*.pem

# Lighthouse CI report output, written by a local audit run (#337).
.lighthouseci/

# Playwright output from a local run of the browser suite (#412).
frontend/e2e/test-results/
frontend/e2e/playwright-report/
