# Every upstream the pod reads, pointed at the sim on localhost:8080, for a uvicorn run on the host (`set -a; source sim/pod.env; set +a`).
OPEN_METEO_FORECAST_URL=http://localhost:8080/open-meteo/v1/forecast
OPEN_METEO_ARCHIVE_URL=http://localhost:8080/open-meteo/v1/archive
OPEN_METEO_AIR_QUALITY_URL=http://localhost:8080/open-meteo/v1/air-quality
OPEN_METEO_CUSTOMER_FORECAST_URL=http://localhost:8080/open-meteo-customer/v1/forecast
OPEN_METEO_CUSTOMER_ARCHIVE_URL=http://localhost:8080/open-meteo-customer/v1/archive
OPEN_METEO_CUSTOMER_AIR_QUALITY_URL=http://localhost:8080/open-meteo-customer/v1/air-quality
OVERPASS_URLS=http://localhost:8080/overpass/api/interpreter
NOMINATIM_URL=http://localhost:8080/nominatim/search
NIFC_URL=http://localhost:8080/nifc/query
USFS_ARCGIS_URL=http://localhost:8080/usfs/
HMS_URL=http://localhost:8080/hms
BROWSER_OPEN_METEO_FORECAST_URL=http://localhost:8080/open-meteo/v1/forecast
BROWSER_OPEN_METEO_ARCHIVE_URL=http://localhost:8080/open-meteo/v1/archive
BROWSER_OPEN_METEO_AIR_QUALITY_URL=http://localhost:8080/open-meteo/v1/air-quality
BROWSER_MAP_TILES_URL=http://localhost:8080/tiles
BROWSER_RADAR_URL=http://localhost:8080/radar
BROWSER_SNOW_URL=http://localhost:8080/snow
