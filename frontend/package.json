{
  "name": "bluebird-forecast",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "npm --prefix tools/eslint ci && tools/eslint/node_modules/.bin/eslint --config tools/eslint/eslint.config.js --max-warnings 0 src e2e && node tools/eslint/selftest.js",
    "generate:api": "npm --prefix tools/api-types ci && npm --prefix tools/api-types run generate",
    "check:api": "npm --prefix tools/api-types ci && npm --prefix tools/api-types run check"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "maplibre-gl": "^6.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "swagger-ui-dist": "^5.32.15",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
